      "parameters": {
        "jsCode": "const email = $(\"Gmail 新郵件觸發\").first()?.json?.to?.value[0]?.address;\nconst blacklist = $input.all().map((item) => item.json.blacklist).flat(); // 合併成一維陣列\n\n// 檢查 email 是否包含任一黑名單字詞\nconst isBlacklisted = blacklist.some((word) => email.includes(word));\n\nif (!isBlacklisted) {\n  return [{ json: { proceed: true } }];\n} else {\n  return [{ json: { proceed: false } }];\n}\n"
      },
